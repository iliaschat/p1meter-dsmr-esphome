# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/.venv/
/secrets.yaml

# Generated web assets (built from components/p1_setup/assets/ by scripts/embed_assets.py)
# These are committed so external_components consumers don't need Python at build time.
# components/p1_setup/web_assets.h
# components/p1_setup/web_assets.cpp

# VS Code
.vscode/*

# Python bytecode
__pycache__/
*.py[cod]

# PlatformIO build output
/.pio/
